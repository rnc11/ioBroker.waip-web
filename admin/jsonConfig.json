{
    "type": "tabs",
    "i18n": true,
    "items": {
        "tabConnection": {
            "type": "panel",
            "label": "Connection",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "url": {
                    "type": "text",
                    "label": "WAIP server URL",
                    "help": "Base URL of the WAIP dispatch server (Socket.IO endpoint, namespace /waip is appended automatically)",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "monitorID": {
                    "type": "selectSendTo",
                    "command": "getMonitorList",
                    "jsonData": "{\"url\": \"${data.url}\"}",
                    "alsoDependsOn": ["url"],
                    "manual": true,
                    "label": "Monitor ID",
                    "help": "Loaded live from the configured server's /waip/ overview page - choose by Leitstelle, Kreis, Träger or Wache, or pick 'Alle Wachalarme' (ID 0) for every incident. If the server can't be reached, an ID can still be entered manually.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_divider1": {
                    "type": "divider"
                },
                "registrationTimeoutSec": {
                    "type": "number",
                    "label": "Registration timeout (s)",
                    "help": "How long to wait for the server to confirm the monitor registration before logging a warning; the connection itself keeps running either way.",
                    "min": 1,
                    "max": 120,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "reconnectDelaySec": {
                    "type": "number",
                    "label": "Reconnect delay (s)",
                    "help": "Wait time before the adapter automatically reconnects after a lost connection or a connection error.",
                    "min": 1,
                    "max": 120,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "tabRescueService": {
            "type": "panel",
            "label": "Rescue-service keywords",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "rdKeywordDecodingEnabled": {
                    "type": "checkbox",
                    "label": "Automatically decode rescue-service keywords (R<RTW>N<NEF>[p][f][-NT], with or without spaces)",
                    "help": "Rescue-service keyword scheme R<RTW>N<NEF>, optionally followed by a p/f modifier and/or an NT suffix (e.g. \"R1N0\" = 1 ambulance, no emergency physician). Two spellings are recognized: without a space and with a hyphen before NT (Leitstelle Lausitz, e.g. \"R1N1p\", \"R1N0-NT\") and with a space and without a hyphen (Leitstelle Brandenburg/IRLS, e.g. \"R1N1 p\", \"R1N0 nt\") - only enable if your dispatch center actually uses one of these patterns. Takes priority over the table on the Keyword descriptions tab when a keyword matches.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "rdLabelR": {
                    "type": "text",
                    "label": "Label for R (ambulance count)",
                    "help": "Text used in the generated description for the R<n> part, e.g. \"Rettungswagen: 1\".",
                    "hidden": "!data.rdKeywordDecodingEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "rdLabelN": {
                    "type": "text",
                    "label": "Label for N (emergency vehicle count)",
                    "help": "Text used in the generated description for the N<n> part, e.g. \"Notfalleinsatzfahrzeug: 0\".",
                    "hidden": "!data.rdKeywordDecodingEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "rdLabelP": {
                    "type": "text",
                    "label": "Label for suffix p (polytrauma)",
                    "help": "Text appended when the keyword ends in \"p\".",
                    "hidden": "!data.rdKeywordDecodingEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "rdLabelF": {
                    "type": "text",
                    "label": "Label for suffix f (first responder)",
                    "help": "Text appended when the keyword ends in \"f\".",
                    "hidden": "!data.rdKeywordDecodingEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "rdLabelNT": {
                    "type": "text",
                    "label": "Label for suffix -NT / nt (special ambulance transport)",
                    "help": "Text appended when the keyword ends in \"-NT\" or \" nt\".",
                    "hidden": "!data.rdKeywordDecodingEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "tabKeywordTable": {
            "type": "panel",
            "label": "Keyword descriptions",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "stichwortMappingHelp": {
                    "type": "staticText",
                    "text": "Maps einsatz.stichwort to einsatz.beschreibung. Comparison is case-insensitive and treats spaces/hyphens as equivalent (any run of either collapses to one before comparing), so e.g. \"H:VU mit P\" and \"H:VU-mit-P\" match the same row - no need for a separate row per spelling. If several rows match, the most specific (longest) pattern wins automatically - row order has no effect on matching, sort by any column freely. Pre-filled with an example fire/rescue keyword list as a starting point - it is not confirmed to match your own dispatch center's actual keywords, edit/replace as needed. To back up or transfer this table, use ioBroker's standard instance configuration export/import (JSON). After using that import, reload the Admin page before checking this table - the open config dialog doesn't refresh it from an external import automatically (a state-sync limitation of the Admin table component itself).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "stichwortMapping": {
                    "type": "table",
                    "label": "Alarm keyword descriptions",
                    "newLine": true,
                    "items": [
                        {
                            "type": "text",
                            "attr": "stichwort",
                            "title": "Keyword / pattern",
                            "width": "35%",
                            "sort": true
                        },
                        {
                            "type": "text",
                            "attr": "beschreibung",
                            "title": "Description",
                            "width": "45%",
                            "sort": true
                        },
                        {
                            "type": "select",
                            "attr": "matchType",
                            "title": "Match",
                            "width": "20%",
                            "sort": true,
                            "options": [
                                { "label": "starts with", "value": "startsWith" },
                                { "label": "contains", "value": "contains" }
                            ]
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
